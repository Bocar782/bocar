# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé secrète (service role) — ne jamais exposer côté client, ne jamais préfixer avec NEXT_PUBLIC_
SUPABASE_SECRET_KEY=

# URL publique du site, utilisée dans les liens de redirection des emails Supabase
# (confirmation d'inscription, réinitialisation de mot de passe).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Anthropic — https://console.anthropic.com/settings/keys
# Ne jamais préfixer avec NEXT_PUBLIC_, ne jamais importer en dehors de src/lib/anthropic/.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Id du Price Stripe du plan Pro (créé une fois dans le dashboard Stripe ou via l'API).
STRIPE_PRICE_ID=price_your_stripe_price_id
# Secret de signature du endpoint webhook — https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
